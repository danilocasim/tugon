# Public gateway base URL and publishable/anon key for the selected environment.
# Set actual values outside version control. No browser bundle needs a service key.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=

# Only for server-side account provisioning and protected operator jobs.
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Canonical HTTPS origin in deployed environments; allowlist the exact auth callback.
TUGON_ORIGIN=http://localhost:3100

# Generate independently for each deployed environment, at least 32 random bytes.
TUGON_SETUP_SECRET=

# If the app reaches Supabase over a private host, set its browser-facing gateway here.
SUPABASE_PUBLIC_URL=
TUGON_LIVE_DELIVERY=off
TUGON_EMAIL_DELIVERY=off
TUGON_SMS_DELIVERY=off
TUGON_AUTH_SMS_ENABLED=off
TUGON_AUTH_SMS_HOOK_SECRET=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
RESEND_API_KEY=
RESEND_FROM=
TUGON_JOBS_SECRET=
TUGON_RETENTION_JOBS=off
TUGON_EVIDENCE_GC=off
